#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$SCRIPT_DIR/scripts"
VERSION="$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "dev")"

export EASYWG_DIR="$SCRIPT_DIR"

usage() {
  cat <<EOF
Easy-WG-Combo CLI v$VERSION

Usage: ./easywg <command> [options]

Commands:
  status                    Show system health summary
  health                    Full system health report
  services                  Show service status only
  doctor                    Check installation health (containers, API, scripts, security)
  update                    Update to the latest version (git pull + image pull + rebuild)

  backup                    Create a configuration backup
  backup --encrypt          Create an encrypted backup (requires age)
  backup --output <dir>     Set backup output directory

  restore <file>            Restore from a backup archive
  restore --dry-run <file>  Validate backup without applying

  security check            Run security scan
  security status           Show last security scan result
  security harden-ssh       Harden SSH configuration (with safety checks)
  security harden-ssh --dry-run  Preview SSH hardening changes

  notify test               Send a test notification
  notify status             Show notification configuration status
  notify send "<message>"   Send a custom notification

  migrate                   Run in-place upgrade migration helper (run once after upgrading from early versions)

  device list               List all devices
  device create             Create a new WireGuard device
  device disable <id>       Disable a device (block VPN access)
  device enable <id>        Re-enable a disabled device
  device revoke <id>        Revoke a device permanently
  device set-expiry <id> <date>  Set device expiration date (YYYY-MM-DD)

  dns profiles              List DNS profiles
  dns device list           List device DNS assignments
  dns device set <id> <profile>  Assign DNS profile to device
  dns bypass <id> <duration>     Enable DNS bypass (15m, 1h, 4h, 24h, permanent)
  dns bypass-revoke <id>    Revoke active DNS bypass

  route modes               List available routing modes
  route set <id> <mode>     Set routing mode for a device

  proxy list                List reverse proxy services
  proxy create              Create a new proxy service (interactive)
  proxy delete <id>         Delete a proxy service
  proxy enable <id>         Enable a proxy service
  proxy disable <id>        Disable a proxy service
  proxy validate            Validate current Caddy config without applying

  monitor list              List uptime monitors
  monitor check <id>        Run a monitor check immediately
  monitor add               Add a new monitor (interactive)
  monitor delete <id>       Delete a monitor

  app catalog               List available apps
  app list                  List installed apps
  app install <id>          Install an app
  app start <id>            Start an app container
  app stop <id>             Stop an app container
  app restart <id>          Restart an app container
  app logs <id>             Show last 200 log lines
  app remove <id>           Remove an installed app

  filedrop list             List active file shares
  filedrop upload <file>    Upload a file and get a share link
  filedrop delete <id>      Delete a file share
  filedrop status           Show storage usage
  filedrop cleanup          Delete expired and exhausted shares

  xray status               Show Xray VLESS+Reality service status
  xray client-uri [label]   Generate VLESS+Reality URI for a client
  xray restart              Restart the Xray container

Options:
  --help, -h                Show this help
  --version, -v             Show version

EOF
}

case "${1:-}" in
  --help|-h|help|"")
    usage
    exit 0
    ;;
  --version|-v)
    echo "easywg v$VERSION"
    exit 0
    ;;
  doctor)
    bash "$SCRIPTS_DIR/doctor.sh" "$@"
    ;;
  update)
    echo "Easy-WG-Combo v$VERSION — checking for updates..."
    git -C "$SCRIPT_DIR" fetch origin
    if [ -n "$(git -C "$SCRIPT_DIR" status --porcelain)" ]; then
      echo "Error: local changes present in $SCRIPT_DIR — refusing to update." >&2
      echo "Review them with:  git -C $SCRIPT_DIR status" >&2
      echo "Then commit, discard, or stash:  git -C $SCRIPT_DIR stash" >&2
      exit 1
    fi
    git -C "$SCRIPT_DIR" pull --ff-only origin main
    "$SCRIPT_DIR/compose.sh" pull
    "$SCRIPT_DIR/compose.sh" up -d --build
    bash "$SCRIPTS_DIR/health.sh" --services-only || true
    echo "Update complete — now at v$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo dev) ($(git -C "$SCRIPT_DIR" rev-parse --short HEAD))"
    ;;
  status|health)
    shift
    bash "$SCRIPTS_DIR/health.sh" "$@"
    ;;
  services)
    bash "$SCRIPTS_DIR/health.sh" --services-only
    ;;
  backup)
    shift
    bash "$SCRIPTS_DIR/backup.sh" "$@"
    ;;
  restore)
    shift
    bash "$SCRIPTS_DIR/restore.sh" "$@"
    ;;
  security)
    shift
    SUBCMD="${1:-check}"
    shift || true
    case "$SUBCMD" in
      check|status)
        bash "$SCRIPTS_DIR/security-check.sh" "$@"
        ;;
      harden-ssh)
        bash "$SCRIPTS_DIR/security-check.sh" --harden-ssh "$@"
        ;;
      *)
        echo "Unknown security subcommand: $SUBCMD" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  notify)
    shift
    SUBCMD="${1:-status}"
    shift || true
    bash "$SCRIPTS_DIR/notify.sh" "$SUBCMD" "$@"
    ;;
  migrate)
    bash "$SCRIPTS_DIR/migrate.sh"
    ;;
  device)
    shift
    bash "$SCRIPTS_DIR/device.sh" "$@"
    ;;
  dns)
    shift
    bash "$SCRIPTS_DIR/dns-profiles.sh" "$@"
    ;;
  route)
    shift
    bash "$SCRIPTS_DIR/dns-profiles.sh" --route "$@"
    ;;
  proxy)
    shift
    bash "$SCRIPTS_DIR/proxy.sh" "$@"
    ;;
  monitor)
    shift
    bash "$SCRIPTS_DIR/monitor.sh" "$@"
    ;;
  app)
    shift
    bash "$SCRIPTS_DIR/apps.sh" "$@"
    ;;
  filedrop)
    shift
    bash "$SCRIPTS_DIR/filedrop.sh" "$@"
    ;;
  xray)
    shift
    bash "$SCRIPTS_DIR/xray.sh" "$@"
    ;;
  *)
    echo "Unknown command: ${1:-}" >&2
    usage
    exit 1
    ;;
esac
