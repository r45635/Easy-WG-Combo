# VPS public IP
WG_HOST=YOUR_VPS_IP

ADMIN_PASSWORD=changeme

# WireGuard password hash — generate with:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'yourpassword'
# Set in docker-compose.override.yml (not here) to avoid $-interpolation:
#   services:
#     wg-easy:
#       environment:
#         PASSWORD_HASH: "$$2a$$12$$..."

# WireGuard
WG_PORT=51820
WG_DEFAULT_DNS=10.8.0.1
WG_MTU=1420
WG_PERSISTENT_KEEPALIVE=25

# Internal ports (not exposed publicly)
PORTAL_PORT=8080
WG_EASY_PORT=51821
ADGUARD_PORT=3000
