# Public IP or hostname of this VPS — used for WireGuard client endpoints and VLESS URIs
# IP: use as-is (e.g. 155.138.131.219)
# Hostname: DNS must point to this VPS before install (e.g. vpn.example.com)
# Can also be changed later from the portal Settings tab without SSH access
WG_HOST=YOUR_VPS_IP

# Public admin HTTPS endpoint (domain preferred for trusted certificates)
# Leave unset to use the VPS IP with a self-signed certificate (tls internal)
# Set to a real FQDN + configure TLS_EMAIL for a trusted Let's Encrypt cert
#ADMIN_DOMAIN=vpn.example.com
TLS_EMAIL=
PUBLIC_HTTPS_ENABLED=yes
FAIL2BAN_JAIL=easy-wg-portal
FAIL2BAN_BANTIME=1h
FAIL2BAN_FINDTIME=10m
FAIL2BAN_MAXRETRY=5

# Short server name shown in the dashboard and used in generated config filenames
SERVER_NAME=vpn-toronto

# Set at install time by bootstrap.sh — do not set a real password here
ADMIN_PASSWORD=
# Optional: fixed session-signing secret so portal logins survive restarts.
# Leave empty for a random per-boot secret (sessions reset on restart).
SESSION_SECRET=

# WireGuard password hash — stored in .env.secrets (gitignored), not here.
# See .env.secrets.example

# WireGuard
WG_PORT=51820
WG_DEFAULT_DNS=10.8.0.1
WG_MTU=1420
WG_PERSISTENT_KEEPALIVE=25

# Internal ports (not exposed publicly)
PORTAL_PORT=8080
PORTAL_HOST=127.0.0.1
WG_EASY_PORT=51821
ADGUARD_PORT=3000

# Backup
BACKUP_DIR=/backups
BACKUP_KEEP=10

# Notifications (set secrets in .env.secrets)
NOTIFICATION_ENABLED=no
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_TO=
SMTP_USERNAME=

# Alert thresholds
ALERT_DISK_THRESHOLD=85
ALERT_CERT_EXPIRY_DAYS=14

# Xray VLESS+Reality — DPI-resistant tunnel (optional)
# Set XRAY_ENABLED=yes then re-run bootstrap.sh to activate.
# Keys and secrets are auto-generated by bootstrap.sh — do not set them here.
# When active, Caddy moves to CADDY_HTTPS_PORT (public HTTPS, self-signed cert).
XRAY_ENABLED=no
XRAY_PORT=443
XRAY_UUID=
XRAY_PUBLIC_KEY=
XRAY_SNI_TARGET=www.cloudflare.com
CADDY_HTTPS_PORT=8443
