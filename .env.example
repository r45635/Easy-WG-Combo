# VPS public IP
WG_HOST=YOUR_VPS_IP

# Public admin HTTPS endpoint (domain preferred for trusted certificates)
ADMIN_DOMAIN=vpn.example.com
TLS_EMAIL=admin@example.com
PUBLIC_HTTPS_ENABLED=yes
FAIL2BAN_JAIL=easy-wg-portal
FAIL2BAN_BANTIME=1h
FAIL2BAN_FINDTIME=10m
FAIL2BAN_MAXRETRY=5

# Short server name shown in the dashboard and used in generated config filenames
SERVER_NAME=vpn-toronto

ADMIN_PASSWORD=changeme

# WireGuard password hash — stored in .env.secrets (gitignored), not here.
# See .env.secrets.example

# WireGuard
WG_PORT=51820
WG_DEFAULT_DNS=10.8.0.1
WG_MTU=1420
WG_PERSISTENT_KEEPALIVE=25

# Internal ports (not exposed publicly)
PORTAL_PORT=8080
PORTAL_HOST=127.0.0.1
WG_EASY_PORT=51821
ADGUARD_PORT=3000
