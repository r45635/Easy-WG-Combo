# VPS public IP
WG_HOST=YOUR_VPS_IP

ADMIN_PASSWORD=changeme

# WireGuard password hash — generate with:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'yourpassword'
# Store in .env.wgeasy (gitignored) — NOT in .env — to avoid $-interpolation:
#   echo "PASSWORD_HASH=\$2a\$12\$..." > .env.wgeasy

# WireGuard
WG_PORT=51820
WG_DEFAULT_DNS=10.8.0.1
WG_MTU=1420
WG_PERSISTENT_KEEPALIVE=25

# Internal ports (not exposed publicly)
PORTAL_PORT=8080
WG_EASY_PORT=51821
ADGUARD_PORT=3000
