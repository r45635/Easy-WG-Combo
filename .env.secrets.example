# Secrets file — copy to .env.secrets (gitignored) and fill in values
# Sourced by compose.sh before running docker compose

# Generate with:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'yourpassword'
export PASSWORD_HASH='$2a$12$REPLACE_WITH_YOUR_HASH_HERE'

# SMTP password for email notifications
export SMTP_PASSWORD=

# Webhook URL (ntfy.sh topic, Slack incoming webhook, Discord webhook, etc.)
export WEBHOOK_URL=
